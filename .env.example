# Identity. Leave blank until the company supplies them.
COMPANY_LEGAL_NAME=
COMPANY_BRAND_NAME=
COMPANY_DOMAIN=
EMAIL_FROM=
EMAIL_FROM_NAME=
PAYOUT_LINE=
OFFER_TEXT=
REFERRER_REWARD_AMOUNT=
CUSTOMER_BENEFIT=
SMS_CONSENT_TEXT=
PRIVACY_TEXT=
TERMS_TEXT=

# Optional overrides. Defaults match the previous signup limit and invite lifetime.
# SIGNUP_RATE_LIMIT=5
# SIGNUP_RATE_WINDOW_MINUTES=10
# QUOTE_RATE_LIMIT=5
# QUOTE_RATE_WINDOW_MINUTES=10
# INVITE_TTL_HOURS=168

# GoHighLevel. Leave blank. Do not commit real tokens.
GHL_API_BASE=https://services.leadconnectorhq.com
GHL_API_VERSION=
GHL_LOCATION_ID=
GHL_PIPELINE_ID=
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REFRESH_TOKEN=
GHL_WEBHOOK_PUBLIC_KEY=
# JSON maps. Example shape only, with empty values:
# GHL_STAGE_IDS={"new_referral":"","appointment_booked":"","install_scheduled":"","install_complete":"","lost":""}
# GHL_CUSTOM_FIELD_IDS={"referralCode":"","referralId":"","referrerId":"","state":"","zip":"","vehicle":""}
GHL_STAGE_IDS=
GHL_CUSTOM_FIELD_IDS=

# Firebase web config. Restrict the key before production use. Never commit a real key.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Set to true only for the local dev server. Never set this in Cloud Functions.
LOCAL_DEV_AUTH=
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=
