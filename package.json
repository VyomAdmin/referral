{
  "name": "referral",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:api": "node --experimental-strip-types server/local.ts",
    "dev:web": "vite",
    "dev": "npm run dev:web",
    "build": "vite build && npm run build --prefix functions",
    "test": "node --experimental-strip-types --test tests/referral-flow.test.ts && npx --yes firebase-tools@14.27.0 emulators:exec --only firestore --project demo-referral \"node --experimental-strip-types --test tests/firestore-rules.test.ts\"",
    "lint": "eslint .",
    "import:coverage": "node --experimental-strip-types scripts/import-coverage.ts"
  },
  "dependencies": {
    "firebase": "^11.9.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.5"
  }
}
